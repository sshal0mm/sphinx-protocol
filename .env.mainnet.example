# Copy to .env.mainnet (never commit it). Scripts run with NETWORK=mainnet read
# this file and never the testnet .env. Keys stay in the macOS keychain.

# Your funded mainnet account; it owns the contract and registers grader keys.
SPHINX_PARENT=
# The escrow contract account, created by scripts/mainnet-accounts.sh.
SPHINX_CONTRACT=
# The grader's caller (pays enclave runs) and the relay's gas account.
SPHINX_RELAYER_ACCOUNT=
SPHINX_GAS_ACCOUNT=
# Where jobs link their task text: the site's mainnet API prefix.
SPHINX_API_PUBLIC_BASE=https://sphinx.sshal0mm.dev/mainnet

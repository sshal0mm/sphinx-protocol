# Copy to .env (never commit .env).

# NEAR testnet parent account that owns the demo sub-accounts.
SPHINX_PARENT=sphinx999.testnet

# DEV ONLY: hex ed25519 seed for the local stand-in grader signer.
# Generate with: cargo run -p sphinx-cli --features dev-signer -- dev keygen
SPHINX_DEV_GRADER_SEED=

# Escrow contract the services and scripts talk to.
SPHINX_CONTRACT=escrow.sphinx999.testnet

# ---- sphinx-relayer (grades jobs in the enclave and posts signed results) ----
# The account registered as the grader's caller; its key pays gas and OutLayer fees.
SPHINX_RELAYER_ACCOUNT=relayer.sphinx999.testnet
SPHINX_RELAYER_KEY=            # ed25519:... (keep it in a secret store, not here)
# Enclave grader build; values are in deployments/testnet.json (.grader.url, .grader.wasm_sha256).
SPHINX_GRADER_URL=
SPHINX_GRADER_SHA256=
SPHINX_POLL_SECS=6

# ---- sphinx-api (job API; gasless relay when SPHINX_RELAYER_* are set) ----
SPHINX_API_ADDR=127.0.0.1:8787
# The address jobs record on chain for task text and submissions: the API's
# public URL. A loopback address is refused unless SPHINX_API_ALLOW_LOOPBACK=1
# (local-only runs).
SPHINX_API_PUBLIC_BASE=https://sphinx.sshal0mm.dev
SPHINX_CODE_DIR=data/code
# Relay limits per sending account (defaults shown).
SPHINX_RELAY_BURST=5
SPHINX_RELAY_PER_MINUTE=10
SPHINX_RELAY_GLOBAL_PER_MINUTE=300
SPHINX_RELAY_MAX_FAILURES=3
SPHINX_RELAY_COOLDOWN_SECS=3600
SPHINX_RELAY_DAILY_MAX=2000    # relayed transactions per UTC day, all callers together
# Account that pays gas for relayed calls (default gas.$SPHINX_PARENT); its key
# comes from the keychain. Without one the API runs read-only.
# SPHINX_GAS_ACCOUNT=
# Lets the relayer read every stored submission; everyone else reads only their
# own code. The same value must reach the API and the relayer. Left empty,
# scripts/serve.sh makes one (keychain on macOS, else data/code-reader-token).
SPHINX_CODE_READER_TOKEN=

# ---- sphinx-mcp (runs on the agent's machine) ----
SPHINX_API=http://127.0.0.1:8787
SPHINX_ACCOUNT=
SPHINX_ACCOUNT_KEY=            # ed25519:... your own key (agent or buyer); never sent anywhere

# Optional: comma-separated NEAR RPC URLs, tried in order (default: FastNEAR, then rpc.testnet.near.org).
# SPHINX_RPC_URLS=https://rpc.testnet.fastnear.com,https://rpc.testnet.near.org
# Optional: a FastNEAR API key (dashboard.fastnear.com). Sent only to FastNEAR, as a header.
# On macOS the scripts also read it from the keychain entry sphinx-fastnear / rpc-key.
# SPHINX_RPC_KEY=

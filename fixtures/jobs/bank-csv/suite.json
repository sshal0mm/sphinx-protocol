{
  "version": 1,
  "runtime": "js-boa/1",
  "entry": "normalize",
  "tests": [
    {
      "args": [
        "Date,Description,Amount\n2026-03-01,Coffee,-3.50\n02/03/2026,\"Salary, March\",\"2.500,00\""
      ],
      "expected": [
        {
          "date": "2026-03-01",
          "amount_cents": -350,
          "description": "Coffee"
        },
        {
          "date": "2026-03-02",
          "amount_cents": 250000,
          "description": "Salary, March"
        }
      ]
    },
    {
      "args": [
        "date,amount,memo\n2026-01-15,12.34,Lunch"
      ],
      "expected": [
        {
          "date": "2026-01-15",
          "amount_cents": 1234,
          "description": "Lunch"
        }
      ]
    },
    {
      "args": [
        "Booking Date,Details,Credit,Debit\n05.01.2026,Refund,19.99,\n06.01.2026,Rent,,1.200,00\n07.01.2026,Both,10,2.5"
      ],
      "expected": [
        {
          "date": "2026-01-05",
          "amount_cents": 1999,
          "description": "Refund"
        },
        {
          "date": "2026-01-06",
          "amount_cents": -120000,
          "description": "Rent"
        },
        {
          "date": "2026-01-07",
          "amount_cents": 750,
          "description": "Both"
        }
      ]
    },
    {
      "args": [
        "DATE , DESCRIPTION , VALUE \n 2026-02-28 , Trimmed  , (12.50) "
      ],
      "expected": [
        {
          "date": "2026-02-28",
          "amount_cents": -1250,
          "description": "Trimmed"
        }
      ]
    },
    {
      "args": [
        "Date,Description,Amount\r\n2026-04-01,CRLF,1\r\n2026-04-02,CRLF2,-2\r\n"
      ],
      "expected": [
        {
          "date": "2026-04-01",
          "amount_cents": 100,
          "description": "CRLF"
        },
        {
          "date": "2026-04-02",
          "amount_cents": -200,
          "description": "CRLF2"
        }
      ]
    },
    {
      "args": [
        "Date,Description,Amount\n2026-04-31,Bad date,1.00\n2025-02-29,Not leap,1.00\n2024-02-29,Leap,1.00"
      ],
      "expected": [
        {
          "date": "2024-02-29",
          "amount_cents": 100,
          "description": "Leap"
        }
      ]
    },
    {
      "args": [
        "Date,Description,Amount\n2026-05-01,\"He said \"\"hi\"\"\",5\n2026-05-02,\"Line one\nline two\",6"
      ],
      "expected": [
        {
          "date": "2026-05-01",
          "amount_cents": 500,
          "description": "He said \"hi\""
        },
        {
          "date": "2026-05-02",
          "amount_cents": 600,
          "description": "Line one\nline two"
        }
      ]
    },
    {
      "args": [
        "Date,Description,Amount\n2026-06-01,US style,\"1,234.56\"\n2026-06-02,Swiss,1'234.56\n2026-06-03,Thousands,\"1,000\"\n2026-06-04,Short decimal,\"12,5\""
      ],
      "expected": [
        {
          "date": "2026-06-01",
          "amount_cents": 123456,
          "description": "US style"
        },
        {
          "date": "2026-06-02",
          "amount_cents": 123456,
          "description": "Swiss"
        },
        {
          "date": "2026-06-03",
          "amount_cents": 100000,
          "description": "Thousands"
        },
        {
          "date": "2026-06-04",
          "amount_cents": 1250,
          "description": "Short decimal"
        }
      ]
    },
    {
      "args": [
        "Date,Description,Amount\n2026-07-01,Euro,\"€1.234,56\"\n2026-07-02,Dollar,$ -45.00\n2026-07-03,Pound,+£7.5"
      ],
      "expected": [
        {
          "date": "2026-07-01",
          "amount_cents": 123456,
          "description": "Euro"
        },
        {
          "date": "2026-07-02",
          "amount_cents": -4500,
          "description": "Dollar"
        },
        {
          "date": "2026-07-03",
          "amount_cents": 750,
          "description": "Pound"
        }
      ]
    },
    {
      "args": [
        "Date,Description,Amount\n\n2026-08-01,After blank,1\n\n"
      ],
      "expected": [
        {
          "date": "2026-08-01",
          "amount_cents": 100,
          "description": "After blank"
        }
      ]
    },
    {
      "args": [
        "Date,Amount\n2026-09-01,10"
      ],
      "expected": [
        {
          "date": "2026-09-01",
          "amount_cents": 1000,
          "description": ""
        }
      ]
    },
    {
      "args": [
        "Date,Description,Amount\nyesterday,Bad,1\n2026-09-02,Bad amount,abc\n2026-09-03,Good,0.01"
      ],
      "expected": [
        {
          "date": "2026-09-03",
          "amount_cents": 1,
          "description": "Good"
        }
      ]
    },
    {
      "args": [
        ""
      ],
      "expected": []
    },
    {
      "args": [
        "Date,Description,Amount"
      ],
      "expected": []
    },
    {
      "args": [
        "Description,Amount,Date\nReordered,99.9,2026-10-10"
      ],
      "expected": [
        {
          "date": "2026-10-10",
          "amount_cents": 9990,
          "description": "Reordered"
        }
      ]
    },
    {
      "args": [
        "Value Date,Payee,Amount\n31.12.2026,Year end,-0.5"
      ],
      "expected": [
        {
          "date": "2026-12-31",
          "amount_cents": -50,
          "description": "Year end"
        }
      ]
    },
    {
      "args": [
        "Date,Description,Amount\n2026-11-01,Big,\"12.345.678,90\"\n2026-11-02,Neg parens,\"(1.234,56)\"\n2026-11-03,Plain parens,(5)"
      ],
      "expected": [
        {
          "date": "2026-11-01",
          "amount_cents": 1234567890,
          "description": "Big"
        },
        {
          "date": "2026-11-02",
          "amount_cents": -123456,
          "description": "Neg parens"
        },
        {
          "date": "2026-11-03",
          "amount_cents": -500,
          "description": "Plain parens"
        }
      ]
    },
    {
      "args": [
        "Date,Description,Credit,Debit\n2026-12-01,Debit negative already,,-30.00\n2026-12-02,Empty both,,"
      ],
      "expected": [
        {
          "date": "2026-12-01",
          "amount_cents": -3000,
          "description": "Debit negative already"
        },
        {
          "date": "2026-12-02",
          "amount_cents": 0,
          "description": "Empty both"
        }
      ]
    },
    {
      "args": [
        "Date,Description,Amount\n13/13/2026,Bad month,1\n00/01/2026,Day zero,1\n2026-1-05,Short,1"
      ],
      "expected": []
    },
    {
      "args": [
        "date,description,amount\n2026-03-05,Spaces in amount,\"1 234,50\"\n2026-03-06,Only cents,.5"
      ],
      "expected": [
        {
          "date": "2026-03-05",
          "amount_cents": 123450,
          "description": "Spaces in amount"
        },
        {
          "date": "2026-03-06",
          "amount_cents": 50,
          "description": "Only cents"
        }
      ]
    }
  ]
}

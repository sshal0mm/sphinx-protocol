    {
      "args": [
        [
          100,
          99,
          98,
          97,
          50,
          60,
          40,
          200
        ]
      ],
      "expected": {
        "dd_bps": 6000,
        "peak": 0,
        "trough": 6
      }
    },
    {
      "args": [
        [
          3,
          2,
          3,
          1
        ]
      ],
      "expected": {
        "dd_bps": 6666,
        "peak": 0,
        "trough": 3
      }
    },
    {
      "args": [
        [
          1000000,
          999999
        ]
      ],
      "expected": {
        "dd_bps": 0,
        "peak": 0,
        "trough": 1

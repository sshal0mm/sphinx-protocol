{
  "version": 1,
  "runtime": "js-boa/1",
  "entry": "maxDrawdown",
  "tests": [
    {
      "args": [
        [
          100,
          120,
          90,
          130,
          104,
          140
        ]
      ],
      "expected": {
        "dd_bps": 2500,
        "peak": 1,
        "trough": 2
      }
    },
    {
      "args": [
        []
      ],
      "expected": {
        "dd_bps": 0,
        "peak": null,
        "trough": null
      }
    },
    {
      "args": [
        [
          100
        ]
      ],
      "expected": {
        "dd_bps": 0,
        "peak": null,
        "trough": null
      }
    },
    {
      "args": [
        [
          100,
          110,
          120,
          130
        ]
      ],
      "expected": {
        "dd_bps": 0,
        "peak": null,
        "trough": null
      }
    },
    {
      "args": [
        [
          100,
          50
        ]
      ],
      "expected": {
        "dd_bps": 5000,
        "peak": 0,
        "trough": 1
      }
    },
    {
      "args": [
        [
          100,
          100,
          100
        ]
      ],
      "expected": {
        "dd_bps": 0,
        "peak": null,
        "trough": null
      }
    },
    {
      "args": [
        [
          100,
          90,
          100,
          90
        ]
      ],
      "expected": {
        "dd_bps": 1000,
        "peak": 0,
        "trough": 1

    },
    {
      "args": [
        [
          7,
          3
        ]
      ],
      "expected": {
        "dd_bps": 5714,
        "peak": 0,
        "trough": 1
      }
    },
    {
      "args": [
        [
          100,
          80,
          120,
          96,
          130,
          104
        ]
      ],
      "expected": {
        "dd_bps": 2000,
        "peak": 0,
        "trough": 1
      }
    },
    {
      "args": [
        [
          50,
          100,
          100,
          60,
          100,
          40
        ]
      ],
      "expected": {
        "dd_bps": 6000,
        "peak": 1,
        "trough": 5
      }
    },
    {
      "args": [
        [
          300,
          200,
          100,
          400,
          100
        ]
      ],
      "expected": {
        "dd_bps": 7500,
        "peak": 3,
        "trough": 4
